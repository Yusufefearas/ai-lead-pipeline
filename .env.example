# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4

# --- Apify (apimaestro/linkedin-profile-search-scraper) ---
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apimaestro/linkedin-profile-search-scraper

# --- Google Sheets (optional) ---
