# GOOGLE_SERVICE_ACCOUNT_JSON is a path to the service-account key file.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Pipeline ---
MAX_LEADS=100
